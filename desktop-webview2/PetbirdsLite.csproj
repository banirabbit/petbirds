<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PetbirdsLite</AssemblyName>
    <RootNamespace>PetbirdsLite</RootNamespace>
    <Version>2.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/robin.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <Reference Include="System.Web.Extensions" />
    <Compile Remove="tests/**/*.cs" />
    <Content Include="web/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/robin.ico" Link="robin.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
